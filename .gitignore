# ==========================================
# MedDhatri - Production .gitignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases

# Production Build Outputs & Caches
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
out/
**/out/
*.tsbuildinfo
.vite/
**/.vite/
.cache/
**/.cache/
.eslintcache
.stylelintcache

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
!.env.example
!.env.template
*.pem
*.key
*.cert

# Storage, Uploads & Temp Files
uploads/
**/uploads/
storage/
**/storage/
temp/
tmp/
*.tmp
*.temp

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# IDE, Editors & OS Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# AI Assistant & IDE Local Data
.gemini/
**/.gemini/
